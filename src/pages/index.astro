---
import BaseLayout from '../layouts/BaseLayout.astro';
import ModelRankChart from '../components/ModelRankChart.astro';
import ModelDivergencePanel from '../components/ModelDivergencePanel.astro';
import PositionEffectComparison from '../components/PositionEffectComparison.astro';
import OrderComparison from '../components/OrderComparison.astro';
import { experiments } from '../lib/experiments';
import { buildComparison, getBiggestDivergences } from '../lib/comparison';
import { pickSurprisePair } from '../lib/narrative';
import { formatInteger, formatPercent, formatMonthYearRange } from '../lib/format';
import { shortPartyName } from '../lib/parties';

const completed = experiments.filter((experiment) => experiment.status === 'completed');
const comparison = buildComparison(experiments);
const hasComparison = comparison.experiments.length >= 2;
const topDivergences = getBiggestDivergences(comparison, 3);

const totalDecisions = completed.reduce((sum, experiment) => sum + experiment.usage.requests.successful, 0);
const partyCount = experiments[0]?.parties.length ?? 10;
const modelNames = completed.map((experiment) => experiment.model.name);
const modelNameList = modelNames.length > 1
  ? `${modelNames.slice(0, -1).join(', ')} und ${modelNames.at(-1)}`
  : modelNames[0] ?? 'Das getestete Modell';
const timelineStarts = completed.map((experiment) => experiment.timeline.firstRequestUtc);
const timelineEnds = completed.map((experiment) => experiment.timeline.lastSuccessfulRequestUtc);
const dataPeriod = timelineStarts.length
  ? formatMonthYearRange(timelineStarts.reduce((min, iso) => (iso < min ? iso : min)), timelineEnds.reduce((max, iso) => (iso > max ? iso : max)))
  : null;
---
<BaseLayout title="KI-Wahltest" description={`${formatInteger(totalDecisions)} dokumentierte Entscheidungen von ${modelNameList} zwischen ${partyCount} deutschen Parteien – Rangvergleich, Reihenfolgeeffekt und Rohdaten.`}>
  <section class="landing-hero">
    <svg class="hero-graphic" viewBox="0 0 800 600" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
      <path d="M 420 60 C 620 60, 560 230, 760 230" />
      <path d="M 400 160 C 600 160, 540 330, 740 330" />
      <path d="M 440 260 C 640 260, 580 430, 780 430" />
      <path d="M 380 360 C 580 360, 520 530, 720 530" />
      <circle cx="420" cy="60" r="5" /><circle cx="760" cy="230" r="5" />
      <circle cx="400" cy="160" r="5" /><circle cx="740" cy="330" r="5" />
      <circle cx="440" cy="260" r="5" /><circle cx="780" cy="430" r="5" />
      <circle cx="380" cy="360" r="5" /><circle cx="720" cy="530" r="5" />
    </svg>
    <div class="container hero-copy">
      <p class="story-kicker">KI-Wahltest</p>
      <h1>Wie entscheiden KI-Modelle zwischen Parteien?</h1>
      <p class="hero-facts">{formatInteger(totalDecisions)} Entscheidungen <i>·</i> {partyCount} Parteien <i>·</i> {completed.length} KI-Modelle{dataPeriod && <> <i>·</i> Erhoben {dataPeriod}</>}</p>
      <p class="hero-lede">Keine Thesen, keine Bewertungsskala: Die Modelle bekommen jeweils zwei Parteien genannt und müssen sich für eine von beiden entscheiden. Jedes mögliche Parteienpaar wird wiederholt und in beiden Reihenfolgen getestet. {modelNameList} durchliefen denselben dokumentierten Versuchsaufbau; untersucht werden vor allem Unterschiede zwischen den Modellen und Effekte der Namensreihenfolge.</p>
      <p class="independent-note">Ein unabhängiges, umfangreich dokumentiertes Projekt. Der Name bezeichnet das Experiment, nicht eine Wahlentscheidungshilfe. Keine Wahlumfrage, keine Wahlempfehlung.</p>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <p class="eyebrow">Was hier anders ist</p>
      <h2>Direktvergleich statt Thesenkatalog</h2>
      <p class="lede">Andere Projekte lassen KI-Modelle häufig politische Thesen beantworten und vergleichen die Antworten anschließend mit Parteipositionen. ki-wahltest.de stellt stattdessen jeweils zwei Parteibezeichnungen direkt gegenüber und beobachtet, wie sich die Modelle dazwischen entscheiden.</p>
      <div class="grid grid--3" style="margin-top:2.5rem">
        <div class="card"><h3>Zwei Parteien, eine Entscheidung</h3><p class="card-copy">Das Modell erhält zwei Parteibezeichnungen und muss sich für eine von beiden entscheiden – ohne Thesen und ohne Bewertungsskala.</p></div>
        <div class="card"><h3>Alle Paare, beide Reihenfolgen</h3><p class="card-copy">Jedes mögliche Parteienpaar wird getestet, jeweils in beiden Namensreihenfolgen und vielfach wiederholt.</p></div>
        <div class="card"><h3>Mehrere Modelle, ein Aufbau</h3><p class="card-copy">Verschiedene KI-Modelle durchlaufen denselben dokumentierten Versuchsaufbau, wodurch sich ihre Entscheidungen direkt vergleichen lassen.</p></div>
      </div>
      <p class="lede detail-link"><a href="/methodik/">Einordnung und verwandte Arbeiten →</a></p>
    </div>
  </section>

  {hasComparison && (
    <section class="section section--surface">
      <div class="container">
        <p class="eyebrow">Modelle im Vergleich</p>
        <h2>Wie unterschiedlich entscheiden die Modelle?</h2>
        <p class="lede">Dieselbe Partei kann von unterschiedlichen Modellen sehr unterschiedlich häufig ausgewählt worden sein. {topDivergences[0] && <>Am deutlichsten bei <strong>{topDivergences[0].party}</strong>: Bei {topDivergences[0].highestEntry.modelName} lag die Auswahlquote bei {formatPercent(topDivergences[0].highestEntry.share)}, bei {topDivergences[0].lowestEntry.modelName} bei {formatPercent(topDivergences[0].lowestEntry.share)} – ein Unterschied von {topDivergences[0].spreadPercentagePoints.toFixed(0)} Prozentpunkten.</>}</p>
        <ModelRankChart comparison={comparison} />
        <p class="lede detail-link"><a href="/ergebnisse/">Alle Ergebnisse im Detail →</a></p>
      </div>
    </section>
  )}

  {hasComparison && (
    <section class="section">
      <div class="container">
        <p class="eyebrow">Größte Unterschiede</p>
        <h2>Wo sich die Modelle am stärksten unterscheiden</h2>
        <p class="lede">Die folgenden Parteien zeigen die größte Spannweite zwischen der höchsten und der niedrigsten beobachteten Auswahlquote unter den getesteten Modellen.</p>
        <ModelDivergencePanel divergences={topDivergences} />
        <p class="lede detail-link"><a href="/ergebnisse/">Vollständigen Vergleich ansehen →</a></p>
      </div>
    </section>
  )}

  <section class="section section--surface">
    <div class="container">
      <p class="eyebrow">Reihenfolgeeffekt</p>
      <h2>Die Reihenfolge kann die Antwort verändern</h2>
      <p class="lede">Bei jedem Modell wurden dieselben zwei Parteien in beiden möglichen Reihenfolgen genannt – bei ansonsten identischem Prompt. In einzelnen Duellen unterschieden sich die beobachteten Auswahlquoten zwischen diesen beiden Bedingungen deutlich.</p>
      <PositionEffectComparison experiments={completed} />
      <div class="position-examples">
        {completed.map((experiment) => {
          const pair = pickSurprisePair(experiment);
          return (
            <div class="position-example">
              <h3>{experiment.model.name}</h3>
              <p class="example-caption">Konkretes Beispiel: <strong>{shortPartyName(pair.parties[0])}</strong> gegen <strong>{shortPartyName(pair.parties[1])}</strong> – je nach Reihenfolge im Prompt.</p>
              <OrderComparison pair={pair} />
              <p class="detail-link"><a href={`/experimente/${experiment.id}/duelle/${pair.id}/`}>Dieses Duell vollständig untersuchen →</a></p>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section closing">
    <div class="container closing-copy">
      <p class="eyebrow">Einordnung</p>
      <h2>Keine Wahlprognose – eine Aussage über KI-Systeme</h2>
      <p>Die Ergebnisse zeigen nicht, welche Partei „gut" oder „schlecht" ist, und sie sind keine Wahlempfehlung. Sie zeigen, wie die getesteten Modelle unter den dokumentierten Versuchsbedingungen entschieden haben – und dass sich die beobachteten Ergebnisse zwischen Modellen und zwischen unterschiedlichen Reihenfolgen im Prompt unterscheiden können.</p>
      <p class="final-statement">Nicht nur was man eine KI fragt, kann eine Rolle spielen.<br /><strong>Sondern auch, welches Modell man fragt und wie man es fragt.</strong></p>
      <p class="closing-links"><a href="/methodik/">Zur Methodik →</a> · <a href="/daten/">Zu den Rohdaten →</a></p>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <p class="eyebrow">Die getesteten Modelle</p>
      <h2>Jede Modell-Story im Detail</h2>
      <p class="lede">Jedes Modell durchlief denselben Versuchsaufbau: {partyCount} Parteien, {experiments[0]?.results.pairs.length ?? 45} Paarungen, beide Reihenfolgen je Paar. Ergebnisse werden erst hier aufgenommen, wenn ein Lauf vollständig abgeschlossen und dokumentiert ist.</p>
      <div class="model-grid">
        {experiments.map((experiment) => (
          <a class="model-card" href={experiment.status === 'completed' ? `/experimente/${experiment.id}/story/` : `/experimente/${experiment.id}/`}>
            <span class="model-name">{experiment.model.name}</span>
            <span class:list={['tag', experiment.status]}>{experiment.status === 'completed' ? 'abgeschlossen' : 'läuft'}</span>
            {experiment.status === 'completed'
              ? <p class="model-stat"><strong>{formatPercent(experiment.results.ranking[0]!.share)}</strong><span>höchste Auswahlquote ({experiment.results.ranking[0]!.party})</span></p>
              : <p class="model-stat"><span>Ergebnisse folgen nach Abschluss des Laufs.</span></p>}
            <i aria-hidden="true">→</i>
          </a>
        ))}
      </div>
      <p class="lede"><a href="/experimente/">Alle Modelle im Überblick →</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .landing-hero{position:relative;display:flex;align-items:center;min-height:clamp(24rem,50vh,34rem);padding-block:5rem;overflow:hidden}
  .hero-graphic{position:absolute;inset:0;z-index:0;width:100%;height:100%;opacity:.5}
  .hero-graphic path{fill:none;stroke:var(--line-strong);stroke-width:1.5;stroke-linecap:round}
  .hero-graphic circle{fill:var(--teal)}
  .hero-copy{position:relative;z-index:1;max-width:60rem}
  @media(max-width:900px){.hero-graphic{display:none}}.story-kicker{margin-bottom:1rem;color:var(--teal);font-size:.8rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.hero-copy h1{max-width:16ch;font-size:clamp(2.4rem,6vw,4.6rem)}.hero-facts{margin-top:1.6rem;font-size:clamp(1rem,2vw,1.2rem);font-weight:750}.hero-facts i{padding-inline:.4rem;color:var(--line-strong);font-style:normal}.hero-lede{max-width:42rem;margin-top:1.2rem;font-size:clamp(1.05rem,2vw,1.3rem);line-height:1.5}.independent-note{margin-top:1.2rem;color:var(--muted);font-size:.88rem}
  .detail-link{margin-top:2rem}.detail-link a{font-weight:750}
  .position-examples{display:grid;gap:3rem;margin-top:3rem}
  .position-example{padding-top:2.5rem;border-top:1px solid var(--line)}.position-example:first-child{padding-top:0;border-top:0}
  .position-example h3{font-size:1.3rem}
  .example-caption{max-width:40rem;margin-top:1.5rem;color:var(--muted)}
  .closing{padding-block:clamp(5rem,10vw,9rem)}.closing-copy{max-width:48rem}.closing-copy>p{margin-top:1.2rem;font-size:1.08rem}
  .final-statement{margin-top:clamp(2.5rem,6vw,4rem)!important;font-size:clamp(1.6rem,4vw,2.6rem);font-weight:650;line-height:1.25;letter-spacing:-.02em}.final-statement strong{display:block;margin-top:.35rem;color:var(--teal)}
  .closing-links{margin-top:2rem!important;font-weight:700}
  @media(max-width:720px){.landing-hero{min-height:auto;padding-block:4rem}}
</style>
