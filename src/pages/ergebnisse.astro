---
import PartyRanking from '../components/PartyRanking.astro';
import PositionBias from '../components/PositionBias.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { experiment } from '../data/experiments/gpt56-main-v2';
import { formatInteger } from '../lib/format';
const effects = [...experiment.results.pairs].sort((a,b) => b.sensitivityPercentagePoints - a.sensitivityPercentagePoints).slice(0,5);
const strongestEffect = effects[0]!;
---
<BaseLayout title="Ergebnisse" description="Ranking, Positionsbias und Reihenfolgeeffekte im GPT-5.6-Sol-Hauptlauf.">
  <section class="page"><div class="container"><p class="eyebrow">GPT-5.6 Sol · Hauptlauf</p><h1>Ergebnisse aus {formatInteger(experiment.parameters.totalRequests)} Paarentscheidungen</h1><p class="lede">Die Auswahlquoten beschreiben ausschließlich, wie oft eine Partei in diesem Versuchsaufbau ausgewählt wurde. Sie sind keine Wahlumfrage und kein Stimmenanteil.</p></div></section>
  <section class="section section--surface"><div class="container"><p class="eyebrow">Deskriptives Ranking</p><h2>Auswahlquote im Paarvergleich</h2><PartyRanking ranking={experiment.results.ranking} /></div></section>
  <section class="section"><div class="container"><p class="eyebrow">Positionseffekt</p><h2>Die zweite Position lag im Mittel vorn</h2><p class="lede">{formatInteger(experiment.results.positionBias.secondSelected)} von {formatInteger(experiment.results.positionBias.total)} Entscheidungen entfielen auf die zweite genannte Partei. Dieser Durchschnitt verdeckt wesentlich stärkere Effekte einzelner Paarungen.</p><PositionBias result={experiment.results.positionBias} /></div></section>
  <section class="section section--surface"><div class="container"><p class="eyebrow">Größte Reihenfolgeeffekte</p><h2>Bis zu {strongestEffect.sensitivityPercentagePoints.toLocaleString('de-DE')} Prozentpunkte Unterschied</h2><div class="effect-list">{effects.map((pair) => <a href={`/duelle/${pair.id}/`}><span>{pair.parties[0]} / {pair.parties[1]}</span><strong>D = {pair.sensitivityPercentagePoints.toLocaleString('de-DE')} PP</strong></a>)}</div><div class="button-row"><a class="button" href="/duelle/">Vollständige Duellmatrix</a></div></div></section>
  <section class="section"><div class="container"><p class="eyebrow">Konstanz innerhalb des Experiments</p><h2>Viele Bedingungen waren vollständig einheitlich</h2><div class="grid grid--3"><div class="card"><p class="card-label">100:0-Blöcke</p><p class="card-value">{experiment.results.deterministicBlocks.perfect} / {experiment.results.deterministicBlocks.total}</p><p class="card-copy">Ein Block sind 100 Wiederholungen derselben Paarung in derselben Reihenfolge.</p></div><div class="card"><p class="card-label">200:0-Duelle</p><p class="card-value">{experiment.results.deterministicDuels.perfect} / {experiment.results.deterministicDuels.total}</p><p class="card-copy">Ein vollständiges Duell umfasst beide Reihenfolgen mit jeweils 100 Wiederholungen.</p></div><div class="card"><p class="card-label">Bradley–Terry</p><p class="card-value">Ridge λ = 1</p><p class="card-copy">Regularisierte Parameter relativer Stärke im Paarvergleich – keine politische Zustimmung.</p></div></div></div></section>
</BaseLayout>
<style>.effect-list{margin-top:2rem;border-top:1px solid var(--line)}.effect-list a{display:flex;justify-content:space-between;gap:1rem;padding:1rem 0;border-bottom:1px solid var(--line);color:var(--ink);text-decoration:none}.effect-list a:hover span{text-decoration:underline}.effect-list strong{white-space:nowrap}@media(max-width:520px){.effect-list a{flex-direction:column;gap:.15rem}}</style>
