---
import OrderComparison from '../../../../components/OrderComparison.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { experiments } from '../../../../lib/experiments';
import { partySlug, shortPartyName } from '../../../../lib/parties';
export function getStaticPaths() {
  return experiments.flatMap((experiment) =>
    experiment.results.pairs.map((pair) => ({ params: { id: experiment.id, slug: pair.id }, props: { experiment, pair } })),
  );
}
const { experiment, pair } = Astro.props;
const [party1, party2] = pair.parties;
---
<BaseLayout title={`${shortPartyName(party1)} gegen ${shortPartyName(party2)} – ${experiment.model.name}`} description={`Ergebnis und Reihenfolgeeffekt im Duell ${party1} gegen ${party2} (${experiment.model.name}).`}>
  <article class="page"><div class="container"><p class="eyebrow">Direktes Duell · 200 Entscheidungen · {experiment.model.name}</p><h1>{shortPartyName(party1)} gegen {shortPartyName(party2)}</h1><p class="lede">So verteilten sich die Entscheidungen insgesamt und in den beiden Reihenfolgen.</p>
    <div class="total-result" aria-label={`Gesamtergebnis: ${party1} ${pair.totals[party1]}, ${party2} ${pair.totals[party2]}`}><p><a href={`/experimente/${experiment.id}/parteien/${partySlug(party1)}/`}>{shortPartyName(party1)}</a><strong>{pair.totals[party1]}</strong></p><i>:</i><p><a href={`/experimente/${experiment.id}/parteien/${partySlug(party2)}/`}>{shortPartyName(party2)}</a><strong>{pair.totals[party2]}</strong></p></div>
    {pair.majorityFlipsWithOrder && <div class="notice flip"><strong>Mehrheitsrichtung wechselte</strong>Zwischen den beiden Reihenfolgen wechselte die beobachtete Mehrheitsrichtung.</div>}
    <h2 class="order-title">Was geschah in den beiden Reihenfolgen?</h2>
    <OrderComparison pair={pair} />
    <div class="plain-difference"><strong>{pair.sensitivityPercentagePoints.toLocaleString('de-DE')}</strong><span>Prozentpunkte Unterschied<br />zwischen den beiden Reihenfolgen</span></div>
    <div class="detail-grid"><div><p class="card-label">Technische Definition</p><h2>Reihenfolgeeffekt D</h2><p class="card-copy">D ist die absolute Differenz der Auswahlquote derselben Partei zwischen den beiden Reihenfolgen. Hier beträgt D {pair.sensitivityPercentagePoints.toLocaleString('de-DE')} Prozentpunkte.</p></div><dl class="meta-list"><dt>Modell</dt><dd><code>{experiment.model.exactModelId}</code></dd><dt>Prompt</dt><dd><code>{experiment.prompt.revision}</code></dd><dt>Reasoning</dt><dd><code>{experiment.parameters.reasoningEffort}</code></dd><dt>Experiment-ID</dt><dd><a href={`/experimente/${experiment.id}/`}><code>{experiment.id}</code></a></dd></dl></div>
    <div class="button-row"><a class="button button--quiet" href={`/experimente/${experiment.id}/duelle/`}>← Zur Duellmatrix</a></div>
  </div></article>
</BaseLayout>
<style>.total-result{display:flex;align-items:flex-end;gap:clamp(1rem,3vw,2rem);margin-top:3rem;padding-block:2rem;border-block:1px solid var(--line)}.total-result p{display:flex;flex-direction:column}.total-result a{color:var(--ink);font-weight:700;text-decoration:none}.total-result a:hover{text-decoration:underline}.total-result strong{font-size:clamp(4rem,11vw,8rem);line-height:.9;letter-spacing:-.07em}.total-result i{padding-bottom:.4rem;color:var(--line-strong);font-size:3rem;font-style:normal}.flip{max-width:48rem;margin-top:2rem}.order-title{margin-top:4rem;font-size:clamp(1.7rem,4vw,2.5rem)}.plain-difference{display:flex;align-items:center;gap:1rem;margin-top:2rem}.plain-difference strong{font-size:clamp(3.5rem,8vw,6rem);line-height:.9;letter-spacing:-.06em}.plain-difference span{line-height:1.3}.detail-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(2rem,6vw,6rem);margin-top:3rem;padding-top:3rem;border-top:1px solid var(--line)}.detail-grid h2{margin-top:.5rem;font-size:1.7rem}.detail-grid .meta-list{margin-top:0}@media(max-width:720px){.detail-grid{grid-template-columns:1fr}.total-result{gap:1rem}.total-result strong{font-size:clamp(3.5rem,18vw,6rem)}.plain-difference{align-items:flex-start;flex-direction:column}}</style>
