---
import { formatInteger, formatPercent } from '../lib/format';
import { partySlug } from '../lib/parties';
import type { PartyResult } from '../lib/types';
interface Props { ranking: PartyResult[]; compact?: boolean; }
const { ranking, compact = false } = Astro.props;
---
<div class:list={['ranking', { 'ranking--compact': compact }]}>
  <ol>
    {ranking.map((result, index) => <li>
      <span class="rank-number" aria-label={`Rang ${index + 1}`}>{index + 1}</span>
      <a class="rank-party" href={`/parteien/${partySlug(result.party)}/`}>{result.party}<small>{formatInteger(result.selected)} / {formatInteger(result.decisions)}</small></a>
      <span class="rank-track" aria-hidden="true"><i style={`width:${result.share * 100}%`}></i></span>
      <strong>{formatPercent(result.share)}</strong>
    </li>)}
  </ol>
</div>
<style>
  .ranking ol{margin:2rem 0 0;padding:0;border-top:1px solid var(--line);list-style:none}.ranking li{display:grid;grid-template-columns:2rem minmax(11rem,1fr) minmax(8rem,1.6fr) 4.5rem;align-items:center;gap:1rem;padding:.8rem 0;border-bottom:1px solid var(--line)}
  .rank-number{color:var(--muted);font-variant-numeric:tabular-nums}.rank-party{color:var(--ink);font-weight:700;text-decoration:none}.rank-party:hover{text-decoration:underline}.rank-party small{display:block;color:var(--muted);font-size:.75rem;font-weight:500}.rank-track{height:.52rem;background:var(--surface-soft)}.rank-track i{display:block;height:100%;background:var(--teal)}.ranking strong{text-align:right;font-variant-numeric:tabular-nums}
  .ranking--compact li{grid-template-columns:1.5rem minmax(9rem,1fr) minmax(5rem,1.2fr) 4rem;padding:.58rem 0}.ranking--compact .rank-party small{display:none}
  @media(max-width:600px){.ranking li{grid-template-columns:1.5rem 1fr 4rem}.rank-track{grid-column:2 / -1;width:100%}}
</style>
