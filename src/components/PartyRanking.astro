---
import { formatInteger, formatPercent } from '../lib/format';
import { partySlug } from '../lib/parties';
import type { PartyResult } from '../lib/types';
interface Props { ranking: PartyResult[]; experimentId: string; compact?: boolean; }
const { ranking, experimentId, compact = false } = Astro.props;
---
<div class:list={['ranking', { 'ranking--compact': compact }]}>
  <ol>
    {ranking.map((result, index) => <li>
      <span class="rank-number" aria-label={`Rang ${index + 1}`}>{index + 1}</span>
      <a class="rank-party" href={`/experimente/${experimentId}/parteien/${partySlug(result.party)}/`}>{result.party}<small>{formatInteger(result.selected)} / {formatInteger(result.decisions)}</small></a>
      <span class="rank-track" aria-hidden="true"><i style={`width:${result.share * 100}%`}></i></span>
      <strong>{formatPercent(result.share)}</strong>
    </li>)}
  </ol>
</div>
<style>
  .ranking ol{margin:2rem 0 0;padding:0;border-top:1px solid var(--line);list-style:none}.ranking li{display:grid;grid-template-columns:2rem minmax(11rem,1fr) minmax(8rem,1.6fr) 4.5rem;align-items:center;gap:1rem;padding:.8rem .5rem;margin-inline:-.5rem;border-radius:var(--radius);border-bottom:1px solid var(--line);transition:background-color .18s var(--ease)}.ranking li:hover{background:var(--surface-soft)}
  .rank-number{color:var(--muted);font-variant-numeric:tabular-nums}.rank-party{color:var(--ink);font-weight:700;text-decoration:none}.rank-party:hover{text-decoration:underline}.rank-party small{display:block;color:var(--muted);font-size:.75rem;font-weight:500}.rank-track{overflow:hidden;height:.52rem;border-radius:99rem;background:var(--surface-soft)}.rank-track i{display:block;height:100%;border-radius:inherit;background:var(--teal);transition:width .4s var(--ease)}.ranking strong{text-align:right;font-variant-numeric:tabular-nums}
  .ranking--compact li{grid-template-columns:1.5rem minmax(9rem,1fr) minmax(5rem,1.2fr) 4rem;padding:.58rem 0}.ranking--compact .rank-party small{display:none}
  @media(max-width:600px){.ranking li{grid-template-columns:1.5rem 1fr 4rem;grid-template-rows:auto auto}.rank-number{grid-column:1;grid-row:1}.rank-party{grid-column:2;grid-row:1}.ranking strong{grid-column:3;grid-row:1}.rank-track{grid-column:1 / -1;grid-row:2;width:100%}}
</style>
