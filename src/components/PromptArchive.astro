---
import { shortPartyName } from '../lib/parties';
import type { PromptVariant } from '../lib/types';
const { variants } = Astro.props as { variants: PromptVariant[] };
const groups = [...new Set(variants.map((variant) => variant.pairId))].map((pairId) => ({
  pairId,
  variants: variants.filter((variant) => variant.pairId === pairId),
}));
---
<div class="prompt-archive">
  {groups.map((group) => {
    const first = group.variants[0]!;
    return <details>
      <summary><span>Paar {group.pairId}: {shortPartyName(first.firstParty)} / {shortPartyName(first.secondParty)}</span><small>2 Reihenfolgen</small></summary>
      <div class="prompt-pair">
        {group.variants.map((variant) => <section class="prompt-variant">
          <h3>{shortPartyName(variant.firstParty)} zuerst · {shortPartyName(variant.secondParty)} zweit</h3>
          <p><span>SHA-256</span><code>{variant.sha256}</code></p>
          <pre><code>{variant.text}</code></pre>
        </section>)}
      </div>
    </details>;
  })}
</div>
<style>
  .prompt-archive{margin-top:1.5rem;border-top:1px solid var(--line)}details{border-bottom:1px solid var(--line)}summary{display:flex;justify-content:space-between;gap:1rem;padding:1rem 0;cursor:pointer;font-weight:700}summary small{color:var(--muted);font-weight:500;white-space:nowrap}.prompt-pair{display:grid;gap:1rem;padding:0 0 1.5rem}.prompt-variant{min-width:0;padding:1rem;border:1px solid var(--line);background:var(--surface)}.prompt-variant h3{font-size:1rem}.prompt-variant p{display:grid;gap:.25rem;margin-top:1rem;color:var(--muted);font-size:.75rem}.prompt-variant p span{font-weight:700;text-transform:uppercase}.prompt-variant p code{overflow-wrap:anywhere;color:var(--ink)}pre{overflow-x:auto;margin:1rem 0 0;padding:1rem;background:var(--surface-soft);font-size:.77rem;line-height:1.55;white-space:pre-wrap}
</style>
