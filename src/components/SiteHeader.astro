---
const pathname = Astro.url.pathname;
const links = [['/ergebnisse/', 'Ergebnisse'], ['/experimente/', 'Modelle'], ['/methodik/', 'Methodik'], ['/daten/', 'Daten'], ['/ueber/', 'Über']] as const;
---
<header class="site-header"><div class="site-header__inner container">
  <a class="brand" href="/" aria-label="KI-Wahltest – Startseite"><span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span>KI-Wahltest<small>Ein Experiment über politische KI-Entscheidungen</small></span></a>
  <nav class="site-nav" aria-label="Hauptnavigation"><ul>{links.map(([href, label]) => <li><a href={href} aria-current={pathname.startsWith(href) ? 'page' : undefined}>{label}</a></li>)}</ul></nav>
</div></header>
