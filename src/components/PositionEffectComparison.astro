---
import { formatPercent } from '../lib/format';
import type { Experiment } from '../lib/types';

const { experiments } = Astro.props as { experiments: Experiment[] };

const markers = experiments.map((experiment) => {
  const value = experiment.results.positionEffect.pFirstIfEqual;
  return {
    id: experiment.id,
    name: experiment.model.name,
    value,
    label: formatPercent(value, 1),
  };
});

const scaleLabel = `Vergleichsskala von 0 bis 100 %, 50 % ist ausgeglichen. ${markers
  .map((marker) => `${marker.name}: ${marker.label}`)
  .join(', ')}.`;
---

<div class="position-comparison">
  <p class="lede">
    Die Skala zeigt für alle Modelle dieselbe Größe: Wären zwei Parteien unter den dokumentierten Bedingungen gleich stark, würde die zuerst genannte Partei laut dem statistischen Bradley-Terry-Modell mit dieser geschätzten Wahrscheinlichkeit ausgewählt. 50&nbsp;% wäre ausgeglichen.
  </p>

  <div class="position-scale" role="img" aria-label={scaleLabel}>
    <div class="position-scale-track">
      <span class="position-scale-center" aria-hidden="true"></span>
      {markers.map((marker) => (
        <span class="position-scale-marker" style={`left:${(marker.value * 100).toFixed(1)}%`}>
          <span class="marker-dot" aria-hidden="true"></span>
          <span class="marker-tag" aria-hidden="true">
            {marker.name}<br /><strong>{marker.label}</strong>
          </span>
        </span>
      ))}
    </div>
    <div class="position-scale-labels">
      <span>0 %</span>
      <span class="position-scale-mid">50 % · ausgeglichen</span>
      <span>100 %</span>
    </div>
  </div>
  <p class="scale-note">Werte über 50&nbsp;% zeigen einen globalen Effekt zugunsten der ersten Position, Werte unter 50&nbsp;% zugunsten der zweiten Position.</p>
</div>

<style>
  .position-comparison { margin-top: 1.8rem; }
  .lede { max-width: 42rem; }

  .position-scale { position: relative; padding-inline: 3rem; margin-top: 3.5rem; margin-bottom: 2.5rem; }
  .position-scale-track { position: relative; height: .5rem; border-radius: 999px; background: var(--line); }
  .position-scale-center { position: absolute; top: -.3rem; bottom: -.3rem; left: 50%; width: 2px; background: var(--line-strong); transform: translateX(-50%); }

  .position-scale-marker { position: absolute; top: 50%; transform: translate(-50%, -50%); }
  .marker-dot {
    display: block; width: 1rem; height: 1rem; border-radius: 50%;
    background: var(--teal); border: 2px solid var(--paper); box-shadow: 0 0 0 1px var(--line-strong);
  }
  .marker-tag {
    position: absolute; left: 50%; transform: translateX(-50%);
    white-space: nowrap; text-align: center; line-height: 1.3;
    font-size: .74rem; font-weight: 650; color: var(--muted);
  }
  .marker-tag strong { display: block; color: var(--ink); font-size: .88rem; font-weight: 750; }
  .marker-tag { bottom: 1.5rem; }

  .position-scale-labels { display: flex; justify-content: space-between; margin-top: 1.5rem; font-size: .76rem; color: var(--muted); }
  .position-scale-mid { font-weight: 750; color: var(--ink); }
  .scale-note { max-width: 42rem; margin-top: .9rem; color: var(--muted); font-size: .82rem; line-height: 1.5; }

  @media (max-width: 480px) {
    .position-scale { padding-inline: 2.2rem; }
    .marker-tag { font-size: .68rem; }
    .marker-tag strong { font-size: .8rem; }
  }
</style>
