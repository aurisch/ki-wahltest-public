---
import { shortPartyName } from '../lib/parties';
import type { PairResult } from '../lib/types';
const { pair, prominent = false } = Astro.props as { pair: PairResult; prominent?: boolean };
---
<div class:list={['orders', { 'orders--prominent': prominent }]}>
  {pair.orders.map((order) => <div class="order">
    <p class="order-label">Wenn <strong>{shortPartyName(order.first)}</strong> zuerst stand</p>
    <div class="score" aria-label={`${shortPartyName(order.first)} ${order.firstSelected} zu ${order.secondSelected} ${shortPartyName(order.second)}`}>
      <span><small>{shortPartyName(order.first)}</small>{order.firstSelected}</span><i>:</i><span><small>{shortPartyName(order.second)}</small>{order.secondSelected}</span>
    </div>
  </div>)}
</div>
<style>
  .orders{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem;margin-top:2rem}.order{padding:clamp(1.2rem,3vw,2rem);border:1px solid var(--line);border-radius:var(--radius-lg);background:var(--surface);box-shadow:var(--shadow-sm)}.order-label{color:var(--muted);font-size:.92rem}.score{display:flex;align-items:flex-end;gap:.55rem;margin-top:1.75rem;font-size:clamp(3.2rem,8vw,6.2rem);font-weight:700;line-height:.8;letter-spacing:-.06em}.score span{display:flex;flex-direction:column;min-width:0}.score small{display:block;overflow:hidden;max-width:12rem;margin-bottom:.8rem;padding-top:.25em;color:var(--muted);font-size:.78rem;line-height:1.5;font-weight:650;letter-spacing:0;text-overflow:ellipsis;white-space:nowrap}.score i{color:var(--line-strong);font-size:.6em;font-style:normal}.orders--prominent .order{color:var(--paper);background:#2e2119;border-color:#4d3c30}.orders--prominent .order-label,.orders--prominent .score small{color:#c9bcaf}.orders--prominent .score i{color:#716155}
  @media(max-width:700px){.orders{grid-template-columns:1fr}.score{font-size:clamp(3rem,18vw,5rem)}}
</style>
