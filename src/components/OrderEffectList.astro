---
import { shortPartyName } from '../lib/parties';
import type { PairResult } from '../lib/types';
const { pairs, experimentId } = Astro.props as { pairs: PairResult[]; experimentId: string };
---
<div class="effect-cards">
  {pairs.map((pair) => <a href={`/experimente/${experimentId}/duelle/${pair.id}/`}>
    <span>{shortPartyName(pair.parties[0])} / {shortPartyName(pair.parties[1])}</span>
    <strong>{pair.sensitivityPercentagePoints.toLocaleString('de-DE')}<small>Prozentpunkte</small></strong>
    <i aria-hidden="true">→</i>
  </a>)}
</div>
<style>
  .effect-cards{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin-top:2rem}.effect-cards a{display:grid;grid-template-rows:auto 1fr auto;min-height:12rem;padding:1.2rem;border-top:2px solid var(--ink);color:var(--ink);text-decoration:none;transition:background-color .18s var(--ease),transform .18s var(--ease),box-shadow .18s var(--ease)}.effect-cards a:hover{background:var(--surface-soft);box-shadow:var(--shadow-md);transform:translateY(-2px)}.effect-cards span{font-weight:700}.effect-cards strong{align-self:end;font-size:clamp(2.2rem,5vw,4rem);line-height:1;letter-spacing:-.05em}.effect-cards small{display:block;margin-top:.35rem;color:var(--muted);font-size:.72rem;font-weight:650;letter-spacing:0}.effect-cards i{justify-self:end;margin-top:1rem;font-style:normal;transition:transform .18s var(--ease)}.effect-cards a:hover i{transform:translateX(.2rem)}
  @media(max-width:820px){.effect-cards{grid-template-columns:repeat(2,1fr)}}@media(max-width:480px){.effect-cards{grid-template-columns:1fr}.effect-cards a{display:flex;align-items:center;justify-content:space-between;gap:1rem;min-height:0;padding:1rem}.effect-cards strong{align-self:auto}.effect-cards i{justify-self:auto;margin-top:0}}
</style>
