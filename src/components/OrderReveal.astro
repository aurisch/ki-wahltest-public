---
import { shortPartyName } from '../lib/parties';
import type { PairResult } from '../lib/types';
const { pair, modelName } = Astro.props as { pair: PairResult; modelName: string };
const [firstOrder, secondOrder] = pair.orders;
const sentence = (order: typeof firstOrder) =>
  `Von 100 Entscheidungen entfielen ${order.firstSelected} auf ${shortPartyName(order.first)} und ${order.secondSelected} auf ${shortPartyName(order.second)}.`;
const trackedParty = pair.parties[0];
const selectedFor = (order: typeof firstOrder) => order.first === trackedParty ? order.firstSelected : order.secondSelected;
const shareFor = (order: typeof firstOrder) => selectedFor(order) / order.runs * 100;
const firstShare = shareFor(firstOrder);
const secondShare = shareFor(secondOrder);
const formatShare = (share: number) => share.toLocaleString('de-DE', { maximumFractionDigits: 1 });
const selectionLabel = shortPartyName(trackedParty) === 'Grüne' ? 'Auswahl der Grünen' : `Auswahl von ${shortPartyName(trackedParty)}`;
---
<div class="reveal">
  <article class="reveal-step">
    <p class="step-label">Reihenfolge A · 100 Entscheidungen</p>
    <h3>{shortPartyName(firstOrder.first)} oder {shortPartyName(firstOrder.second)}?</h3>
    <p class="party-order"><strong>{firstOrder.first}</strong><span>gegen</span><strong>{firstOrder.second}</strong></p>
    <p class="reveal-score" aria-label={`${firstOrder.firstSelected} zu ${firstOrder.secondSelected}`}><strong>{firstOrder.firstSelected}</strong><i>:</i><strong>{firstOrder.secondSelected}</strong></p>
    <p>{modelName}: {sentence(firstOrder)}</p>
  </article>
  <div class="turn"><span>Und mit vertauschter Reihenfolge?</span></div>
  <article class="reveal-step">
    <p class="step-label">Reihenfolge B · 100 Entscheidungen</p>
    <h3>{shortPartyName(secondOrder.first)} oder {shortPartyName(secondOrder.second)}?</h3>
    <p class="party-order"><strong>{secondOrder.first}</strong><span>gegen</span><strong>{secondOrder.second}</strong></p>
    <p class="reveal-score" aria-label={`${secondOrder.firstSelected} zu ${secondOrder.secondSelected}`}><strong>{secondOrder.firstSelected}</strong><i>:</i><strong>{secondOrder.secondSelected}</strong></p>
    <p>{modelName}: {sentence(secondOrder)}</p>
  </article>
  <div class="only-order"><p>Dieselbe Versuchsanweisung.<br />Dasselbe Modell.<br />Dieselben Parteien.</p><strong>Die beiden Parteinamen standen in umgekehrter Reihenfolge.</strong></div>
  <div class="effect-number">
    <p class="effect-shift"><span>{selectionLabel}</span><b>{formatShare(firstShare)} % → {formatShare(secondShare)} %</b></p>
    <strong>{pair.sensitivityPercentagePoints.toLocaleString('de-DE')}</strong><span>Prozentpunkte Unterschied</span>
    <p>Absolute Differenz der Auswahlquote derselben Partei zwischen den beiden Reihenfolgen.</p>
  </div>
</div>
<style>
  .reveal{margin-top:3rem}.reveal-step{padding-block:clamp(3rem,8vw,7rem);border-top:1px solid var(--line)}.step-label{color:var(--teal);font-size:.78rem;font-weight:750;letter-spacing:.08em;text-transform:uppercase}.reveal-step h3{margin-top:1rem;font-size:clamp(2rem,5vw,4.5rem)}.party-order{display:flex;align-items:center;gap:1rem;margin-top:2rem;font-size:clamp(1rem,2vw,1.35rem)}.party-order span{color:var(--muted)}.reveal-score{display:flex;gap:clamp(.7rem,2vw,1.5rem);margin-block:2.5rem;font-size:clamp(6rem,20vw,14rem);font-weight:750;line-height:.65;letter-spacing:-.09em}.reveal-score i{color:var(--line-strong);font-style:normal}.reveal-step>p:last-child{max-width:42rem;color:var(--muted);font-size:1.08rem}.turn{padding:2rem 0;border-block:1px solid var(--line);font-size:clamp(1.4rem,3vw,2.2rem);font-weight:700}.only-order{display:grid;grid-template-columns:1fr 1fr;gap:2rem;padding-block:clamp(3rem,7vw,6rem);font-size:clamp(1.2rem,2.5vw,1.8rem)}.only-order strong{align-self:end}.effect-number{padding-block:clamp(3rem,8vw,7rem);color:var(--paper);background:var(--ink);box-shadow:0 0 0 100vmax var(--ink);clip-path:inset(0 -100vmax)}.effect-number>strong,.effect-number>span{display:block}.effect-number>strong{font-size:clamp(7rem,25vw,16rem);line-height:.75;letter-spacing:-.09em}.effect-number>span{margin-top:1rem;font-size:clamp(1.8rem,4vw,3.5rem);font-weight:700}.effect-number>p{max-width:42rem;margin-top:2rem;color:#d6c9bd;font-size:1.1rem}.effect-shift{padding-bottom:2rem;border-bottom:1px solid #4d3c30}.effect-shift span{font-size:1rem;font-weight:700}.effect-shift b{display:block;margin-top:.45rem;color:var(--paper);font-size:clamp(2rem,5vw,4rem);line-height:1.05}
  @media(max-width:620px){.party-order{align-items:flex-start;flex-direction:column;gap:.25rem}.reveal-score{font-size:clamp(5rem,29vw,8rem)}.only-order{grid-template-columns:1fr}.effect-number strong{font-size:clamp(6rem,35vw,10rem)}}
</style>
