{
  "name": "ki-wahltest.de",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "audit:retries": "node scripts/audit-retries.mjs",
    "audit:independent": "node scripts/audit-independent.mjs",
    "audit:data": "node scripts/audit-data.mjs && node scripts/audit-derived-semantics.mjs && npm run audit:retries",
    "audit:site": "node scripts/audit-site.mjs && node scripts/audit-copy-semantics.mjs",
    "check:launch": "npm run build && npm run audit:site && node scripts/check-launch.mjs",
    "validate:data": "npm run audit:data && npm run audit:independent",
    "prebuild": "npm run audit:data",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.9"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
